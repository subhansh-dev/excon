# Server
PORT=2567
RUNS_DIR=./runs
SCENARIO=reach

# Instructor console password. Empty = open (fine for lab demos).
# Set on the server AND share with evaluators: ?view=instructor&pw=…
ROOM_PASSWORD=

# Database (optional for local dev — JSONL carries the run when unset).
# Docker laptop or hosted Postgres (Supabase/Neon): paste the connection string here.
DATABASE_URL=postgresql://dssc:dssc@localhost:5432/dssc_trainer

# LLM inject enrichment (optional — canned injects always work without this).
# Cerebras (OpenAI-compatible). gpt-oss-120b = best quality on the free trial;
# gemma-4-31b = faster fallback. Any OpenAI-compatible base URL works.
LLM_API_KEY=
LLM_BASE_URL=https://api.cerebras.ai/v1
LLM_MODEL=gpt-oss-120b
