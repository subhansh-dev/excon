{
  "name": "dssc-trainer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Immersive multi-domain decision-making trainer for degraded communication environments (SIH26248)",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch --env-file=.env server/index.ts",
    "build": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "preview": "vite preview",
    "start": "tsx --env-file=.env server/index.ts",
    "start:prod": "node dist-server/server/index.js",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx server/smoke.ts",
    "smoke:join": "tsx --env-file=.env server/join-smoke.ts",
    "smoke:demo": "tsx server/demo-verify.ts",
    "llm:test": "tsx --env-file=.env server/llm-test.ts",
    "db:migrate": "tsx --env-file=.env server/db/migrate.ts"
  },
  "dependencies": {
    "@colyseus/schema": "5.0.35",
    "@colyseus/sdk": "0.18.4",
    "@colyseus/ws-transport": "0.18.4",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "cesium": "^1.146.0",
    "colyseus": "0.18.9",
    "express": "^4.21.2",
    "leaflet": "1.9.4",
    "milsymbol": "3.0.4",
    "pg": "^8.13.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "^4.2.1",
    "seedrandom": "^3.0.5",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.11.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/seedrandom": "^3.0.8",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-cesium": "^1.2.23"
  }
}
